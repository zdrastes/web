# Трекер (публичный API)
TRACKER_BASE_URL=https://tracker.example.com
# Токен (Basic auth: <логин>:<токен>). Без него сайт работает на кэше/нулях.
TRACKER_TOKEN=
TRACKER_NAMESPACE=demo-namespace
TRACKER_PROJECT=DEMO
# id статусов через запятую; пусто = все статусы
TRACKER_STATUS_IDS=

# Вход через SSO (Authorization Code Flow + PKCE)
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=l2-analytics
KEYCLOAK_CLIENT_SECRET=
# Тот же Url редиректа, что в клиенте SSO: {адрес сервиса}/auth/callback
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

# Логины, получающие роль admin при первом входе; остальные — viewer (дашборд).
ADMINS=

# Демо-режим: без трекера и SSO, на синтетических данных (1 = включён).
DEMO_MODE=1

# Сессии
SESSION_TTL_HOURS=12
# Включить за обратным прокси с HTTPS (Set-Cookie Secure)
SECURE_COOKIES=0

# Приложение
# Пусто = SQLite-файл l2_analytics.db рядом с проектом
DB_URL=
SYNC_INTERVAL_MINUTES=30
DEFAULT_WEEKS=6
