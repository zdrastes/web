# WB Tracker (публичный API)
TRACKER_BASE_URL=https://tracker.wb.ru
# Токен botband_sa (Basic auth: botband_sa:<токен>). Без него сайт работает на кэше/нулях.
TRACKER_TOKEN=
TRACKER_NAMESPACE=LOGSUPPORT
TRACKER_PROJECT=SPL
# id статусов через запятую; пусто = все статусы (проверить на Этапе 0 плана)
TRACKER_STATUS_IDS=

# Вход через Keycloak (SSO) — значения из выполненной заявки «KeyCloak Россия».
# Issuer — адрес realm: endpoints см. {issuer}/.well-known/openid-configuration.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=l2-analytics
KEYCLOAK_CLIENT_SECRET=
# Тот же Url редиректа, что в заявке: {адрес сервиса}/auth/callback
KEYCLOAK_REDIRECT_URI=http://localhost:8000/auth/callback

# Логины Keycloak, получающие роль admin при первом входе; остальные — viewer (дашборд).
ADMINS=

# Сессии
SESSION_TTL_HOURS=12
# Включить за обратным прокси с HTTPS (Set-Cookie Secure)
SECURE_COOKIES=0

# Приложение
# Пусто = SQLite-файл l2_analytics.db рядом с проектом
DB_URL=
SYNC_INTERVAL_MINUTES=30
DEFAULT_WEEKS=6
